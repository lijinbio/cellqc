# Packaging metadata lives in pyproject.toml; this file only adds the files an
# sdist needs beyond the package itself. CLAUDE.md is guidance for coding agents
# working IN this repo and has no business in a distribution, so the .md files
# are named rather than globbed.
include README.md CHANGELOG.md LICENSE
graft envs

exclude CLAUDE.md
prune tests
prune docs

global-exclude *.py[cod]
global-exclude __pycache__
