((# Beamer deck for a cellqc run.

	Data-driven: every frame comes from a loop over the sample table or over a
	declared figure list, so a new sample needs no edit here. A figure that is
	not expected for a sample (e.g. no BAM -> no nuclear fraction) drops its
	frame; one that a failed or skipped step did not produce keeps its frame with
	the reason instead of the image. Neither fails the LaTeX build.

	Jinja is configured with LaTeX-safe delimiters -- ((* *)) for statements,
	((( ))) for expressions -- so TeX braces are left alone.
#))
\documentclass[aspectratio=169,10pt]{beamer}

\usetheme{Madrid}
\definecolor{retina}{RGB}{16,110,120}
\setbeamercolor{structure}{fg=retina}
\setbeamercolor{frametitle}{bg=retina,fg=white}
\setbeamerfont{frametitle}{size=\large}
\setbeamersize{text margin left=12pt,text margin right=12pt}
\setbeamertemplate{navigation symbols}{}

\definecolor{mut}{RGB}{196,78,82}
\definecolor{wt}{RGB}{76,114,176}

\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage[T1]{fontenc}

% Shrink a box to fit the slide only when it is too big -- never enlarge it.
% Tables are built from stats files whose size depends on the data: without the
% width check a wide table runs off the right-hand edge, and without the height
% check a long one runs off the bottom and takes the text under it along. The
% height limit leaves room for a line of text below the table.
\newsavebox{\fitbox}
\newcommand{\fitwidth}[1]{%
	\sbox{\fitbox}{#1}%
	\ifdim\wd\fitbox>\linewidth
		\sbox{\fitbox}{\resizebox{\linewidth}{!}{\usebox{\fitbox}}}%
	\fi
	\ifdim\dimexpr\ht\fitbox+\dp\fitbox\relax>0.68\textheight
		\sbox{\fitbox}{\resizebox*{!}{0.68\textheight}{\usebox{\fitbox}}}%
	\fi
	\usebox{\fitbox}}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.15}

\title{((( title )))}
\subtitle{Single-cell RNA-seq quality control}
((# Deliberately not \today: result/report_slides.tex is kept next to the PDF,
   and \today would make a later recompile of that same .tex produce a deck with
   a different date -- the archived source would stop reproducing the archived
   output. The date is fixed in Python at render time, in ISO 8601 so it reads
   the same everywhere. #))
\date{((( date )))}

