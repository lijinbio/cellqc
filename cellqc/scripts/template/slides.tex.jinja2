((# Beamer deck for a cellqc run.

	Data-driven: every frame comes from a loop over the sample table or over a
	declared figure list, so a new sample needs no edit here. A figure that does
	not exist for a sample (e.g. no BAM -> no nuclear fraction) drops its frame
	rather than failing the LaTeX build.

	Jinja is configured with LaTeX-safe delimiters -- ((* *)) for statements,
	((( ))) for expressions -- so TeX braces are left alone.
#))
\documentclass[aspectratio=169,10pt]{beamer}

\usetheme{Madrid}
\definecolor{retina}{RGB}{16,110,120}
\setbeamercolor{structure}{fg=retina}
\setbeamercolor{frametitle}{bg=retina,fg=white}
\setbeamerfont{frametitle}{size=\large}
\setbeamersize{text margin left=12pt,text margin right=12pt}
\setbeamertemplate{navigation symbols}{}

\definecolor{mut}{RGB}{196,78,82}
\definecolor{wt}{RGB}{76,114,176}

\usepackage{graphicx}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage[T1]{fontenc}

% Shrink a box to the text width only when it is too wide -- never enlarge it.
% Tables are built from stats files whose width depends on the data, so without
% this a wide cohort table silently runs off the right-hand edge of the slide.
\newsavebox{\fitbox}
\newcommand{\fitwidth}[1]{%
	\sbox{\fitbox}{#1}%
	\ifdim\wd\fitbox>\linewidth
		\resizebox{\linewidth}{!}{\usebox{\fitbox}}%
	\else
		\usebox{\fitbox}%
	\fi}
\setlength{\tabcolsep}{5pt}
\renewcommand{\arraystretch}{1.15}

\title{((( title )))}
\subtitle{Single-cell RNA-seq quality control}
((# Deliberately not \today: result/report_slides.tex is kept next to the PDF,
   and \today would make a later recompile of that same .tex produce a deck with
   a different date -- the archived source would stop reproducing the archived
   output. The date is fixed in Python at render time, in ISO 8601 so it reads
   the same everywhere. #))
\date{((( date )))}

\begin{document}

\begin{frame}
	\titlepage
	\begin{center}\footnotesize
	((( nsample ))) sample((( 's' if nsample != 1 else '' ))) \quad|\quad
	cellqc v((( version ))) \quad|\quad random seed ((( seed )))
	\end{center}
\end{frame}

((# --- What ran --------------------------------------------------------- #))
\begin{frame}{What this run did}
	\footnotesize
	\begin{columns}[T]
	\begin{column}{0.52\textwidth}
	\textbf{Pipeline}
	\begin{enumerate}
		\item Ambient RNA: \textbf{((( ambient_method )))}((* if ambient_compare *)) \\
			\textcolor{gray}{compared (not applied): ((( ambient_compare|join(', ') )))}((* endif *))
		\item Filter on counts, genes, \% mitochondrial
		\item Doublets: ((( callers|join(', ') ))) \\
			\textcolor{gray}{cells removed by \textbf{((( decider )))} only}
		\item Nuclear fraction: ((( nf_ran )))/((( nsample ))) sample((( 's' if nsample != 1 else '' )))
	\end{enumerate}
	\end{column}
	\begin{column}{0.44\textwidth}
	\textbf{Thresholds}
	\begin{itemize}
		\item min UMI per cell: ((( cfg_mincount )))
		\item min genes per cell: ((( cfg_minfeature )))
		\item max \% mitochondrial: ((( cfg_mito )))
		\item expected doublet rate: ((( cfg_rate ))) at ((( cfg_capacity ))) cells/reaction
	\end{itemize}
	\end{column}
	\end{columns}
\end{frame}

((# --- Cohort summary --------------------------------------------------- #))
((* if cascade_table *))
\begin{frame}{Cells retained at each stage}
